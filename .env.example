################################################################################
#                    CLAUDYGOD INFRASTRUCTURE CONFIGURATION                   #
#                   (Supabase + Brevo + Shared Proxy)                         #
#                                                                              #
# IMPORTANT: This file is a TEMPLATE. NEVER commit real secrets to git.       #
# Copy this to .env, fill in actual values, keep .env out of git.             #
#                                                                              #
# Production Setup:                                                            #
#   Database:      Supabase PostgreSQL (managed)                              #
#   Email:         Brevo SMTP Relay (managed)                                 #
#   Reverse Proxy: Traefik v3 (shared at ~/apps/proxy)                       #
#   Monitoring:    Grafana (optional, self-hosted)                            #
#   Images:        GHCR (ghcr.io/claudygod-musicministries)                  #
################################################################################

################################################################################
#                          DOMAIN CONFIGURATION                                #
################################################################################

DOMAIN=claudygod.org
API_DOMAIN=api.claudygod.org
COMPOSE_PROJECT_NAME=claudygod
TZ=UTC

################################################################################
#                       IMAGE REGISTRY (GHCR)                                 #
#                                                                              #
# Images are built and pushed automatically by GitHub Actions on every        #
# push to main in the CGM-Backend and website2.0 repositories.                #
#                                                                              #
# IMPORTANT: Image names are DIFFERENT from repo names:                       #
#   website2.0 repo     → cgm-web Docker image                                #
#   cgm-api repo        → cgm-api Docker image                                #
#                                                                              #
# Tag options:                                                                 #
#   latest     — always the most recent build from main                       #
#   sha-abc123 — pinned to a specific commit (safe for rollbacks)             #
################################################################################

TAG=sha-REPLACE_WITH_COMMIT

BACKEND_IMAGE=ghcr.io/claudygod-musicministries/cgm-api:${TAG}
FRONTEND_IMAGE=ghcr.io/claudygod-musicministries/cgm-web:${TAG}

################################################################################
#                  SUPABASE PostgreSQL CONNECTION STRING                      #
#                                                                              #
# Get from: Supabase Dashboard → Project Settings → Database                  #
#   → Connection Pooler → "Shared Pooler" (IPv4, port 5432)                  #
# Format: postgresql://[user]:[password]@[pooler-host]:5432/postgres           #
################################################################################

SUPABASE_CONNECTION_STRING=postgresql://postgres.CHANGE_ME:CHANGE_ME_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

################################################################################
#                             REDIS CACHE                                      #
#                                                                              #
# Generate: openssl rand -base64 32                                            #
################################################################################

REDIS_PASSWORD=CHANGE_ME
# Sessions must not be silently evicted. If Redis becomes cache-only, this may
# be changed deliberately after application review.
REDIS_MAX_MEMORY_POLICY=noeviction

# Logical backup settings (Supabase PITR/backups remain the primary recovery layer)
BACKUP_RETENTION_DAYS=30
POSTGRES_CLIENT_IMAGE=postgres:16-alpine
# AWS_BACKUP_BUCKET=s3://your-private-backup-bucket/claudygod
# Public age recipient used to encrypt every backup before it reaches disk.
BACKUP_AGE_RECIPIENT=age1REPLACE_ME
# Restore hosts only: path to the private age identity (never commit it).
BACKUP_AGE_IDENTITY_FILE=/etc/claudygod/backup-age-key.txt

################################################################################
#                        JWT & ENCRYPTION SECRETS                              #
#                                                                              #
# JWT_KEY:        openssl rand -base64 48   (minimum 48 bytes)                #
# ENCRYPTION_KEY: openssl rand -base64 32   (AES-256, 32 bytes)               #
################################################################################

JWT_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
# Shared with the web/admin gateway; backend production startup requires at
# least 32 random characters. Generate with: openssl rand -base64 48
INTERNAL_API_KEY=CHANGE_ME

################################################################################
#                        BREVO EMAIL (SMTP RELAY)                             #
#                                                                              #
# Get SMTP credentials from: Brevo Dashboard → Settings → SMTP & API          #
# Verify sender domain before going live.                                      #
################################################################################

EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=CHANGE_ME@smtp-brevo.com
EMAIL_SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM_NAME="ClaudyGod Music Ministries"
EMAIL_FROM_ADDRESS=noreply@claudygod.org

################################################################################
#                   PAYSTACK PAYMENT GATEWAY (OPTIONAL)                        #
#                                                                              #
# Get from: https://dashboard.paystack.com/#/settings/developers              #
# Use LIVE keys in production (not test keys).                                 #
# Leave blank initially — set when payment processing is ready                #
################################################################################

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

################################################################################
#                  AI_PROVIDER AI AI (OPTIONAL)                              #
#                                                                              #
# Get from: https://console.ai-provider.com/settings/keys                       #
# Leave blank initially — set when payment validation is enabled              #
################################################################################

AI_PROVIDER_API_KEY=
AI_MODEL=ai-sonnet-4-6

################################################################################
#                SUPABASE S3-COMPATIBLE STORAGE (WEBSITE MEDIA)                #
#                                                                              #
# Get from: Supabase Dashboard → Project Settings → Storage → S3 Connection   #
# Used by the API's upload pipeline (sermons/media) — required, boot fails    #
# without these (see WebsiteStorageOptions / DependencyInjection.cs).         #
################################################################################

STORAGE_WEBSITE_S3_ENDPOINT=CHANGE-ME
STORAGE_WEBSITE_S3_REGION=us-east-1
STORAGE_WEBSITE_S3_ACCESS_KEY_ID=CHANGE-ME
STORAGE_WEBSITE_S3_SECRET_ACCESS_KEY=CHANGE-ME
STORAGE_WEBSITE_BUCKET=CHANGE-ME
STORAGE_WEBSITE_PUBLIC_BASE_URL=CHANGE-ME

################################################################################
#                            PRODUCTION CHECKLIST                              #
################################################################################

# Before first deploy, verify:
#
# ✅ Supabase:   Project created, connection string from Pooler (IPv4, port 5432)
# ✅ Brevo:      Sender verified, SMTP Login + Key from dashboard
# ✅ Paystack:   LIVE API keys (not test)
# ✅ AIProvider:  API key created with billing set up
# ✅ Storage:    Supabase S3 connection details set (STORAGE_WEBSITE_*)
# ✅ DNS:        claudygod.org and api.claudygod.org → server IP
# ✅ Server:     Shared Traefik proxy running (~/apps/proxy)
# ✅ Network:    docker network create traefik-public
# ✅ GHCR:       echo PAT | docker login ghcr.io -u USERNAME --password-stdin
# ✅ GitHub:     Set Actions secrets (VPS_HOST, VPS_USER, VPS_SSH_KEY, VPS_DEPLOY_PATH)
