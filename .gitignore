# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local

# Traefik ACME certificates (sensitive, generated at runtime)
docker/traefik/acme.json

# Logs and temporary files
*.log
logs/
*.swp
*.swo
*~

# Database exports and backups (local only, not for repo)
backups/
.releases/
dumps/
*.sql
*.sql.gz
*.sql.gz.age
*age-key*

# Container artifacts
docker/*/node_modules
docker/*/.next
docker/*/dist

# IDE and editor files
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# OS files
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
tmp/
temp/
.tmp/
